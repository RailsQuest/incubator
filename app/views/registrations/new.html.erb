<div class="bg-adventure-mountain bg-opacity-20 p-8 rounded-lg shadow-xl max-w-md mx-auto">
  <h1 class="text-3xl font-bold text-adventure-forest mb-6">Join the Quest</h1>

  <%= form_with(url: sign_up_path, class: "space-y-6") do |form| %>
    <% if @user.errors.any? %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
        <h2 class="font-bold"><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
        <ul class="list-disc list-inside">
          <% @user.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :email, class: "block text-sm font-medium text-adventure-rock" %>
      <%= form.email_field :email, value: @user.email, required: true, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border-adventure-river shadow-sm focus:border-adventure-forest focus:ring focus:ring-adventure-forest focus:ring-opacity-50" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium text-adventure-rock" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-adventure-river shadow-sm focus:border-adventure-forest focus:ring focus:ring-adventure-forest focus:ring-opacity-50" %>
      <div class="mt-1 text-sm text-adventure-rock">12 characters minimum.</div>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "block text-sm font-medium text-adventure-rock" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-adventure-river shadow-sm focus:border-adventure-forest focus:ring focus:ring-adventure-forest focus:ring-opacity-50" %>
    </div>

    <div>
      <%= form.submit "Begin Your Adventure", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-adventure-forest hover:bg-adventure-forest focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-adventure-forest" %>
    </div>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to "Already on a quest? Sign in", sign_in_path, class: "text-sm font-medium text-adventure-river hover:text-adventure-forest" %>
  </div>
</div>
