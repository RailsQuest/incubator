<% if notice %>
  <p class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert"><%= notice %></p>
<% end %>
<% if alert %>
  <p class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert"><%= alert %></p>
<% end %>

<div class="bg-adventure-mountain bg-opacity-20 p-8 rounded-lg shadow-xl max-w-md mx-auto">
  <h1 class="text-3xl font-bold text-adventure-forest mb-6">Embark on Your Quest</h1>

  <%= form_with(url: sign_in_path, class: "space-y-6") do |form| %>
    <div>
      <%= form.label :email, class: "block text-sm font-medium text-adventure-rock" %>
      <%= form.email_field :email, value: params[:email_hint], required: true, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border-adventure-river shadow-sm focus:border-adventure-forest focus:ring focus:ring-adventure-forest focus:ring-opacity-50" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium text-adventure-rock" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-1 block w-full rounded-md border-adventure-river shadow-sm focus:border-adventure-forest focus:ring focus:ring-adventure-forest focus:ring-opacity-50" %>
    </div>

    <div>
      <%= form.submit "Begin Adventure", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-adventure-forest hover:bg-adventure-forest focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-adventure-forest" %>
    </div>
  <% end %>

  <div class="mt-6 flex items-center justify-between">
    <%= link_to "Join the Quest", sign_up_path, class: "text-sm font-medium text-adventure-river hover:text-adventure-forest" %>
    <%= link_to "Lost Your Map?", new_identity_password_reset_path, class: "text-sm font-medium text-adventure-river hover:text-adventure-forest" %>
  </div>
</div>
